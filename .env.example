# Copy this file to .env.local and fill in the values for your setup.
# .env.local is git-ignored, so your device address is not committed.

# IP address or hostname of the ESP32 on your local network (required in "real" mode)
NEXT_PUBLIC_ESP32_IP=<your-esp32-ip>

# Optional: WebSocket port and path exposed by the firmware (defaults: 81 and "/")
# NEXT_PUBLIC_ESP32_WS_PORT=81
# NEXT_PUBLIC_ESP32_WS_PATH=/
